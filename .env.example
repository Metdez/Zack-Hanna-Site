# PostHog project token. This value is safe to expose in the browser but should
# still be set through your deployment environment, not committed in .env.local.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token

# First-party proxy path and the US Cloud dashboard. For EU Cloud, switch these
# hosts to eu.i.posthog.com, eu-assets.i.posthog.com, and eu.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=/moss
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_INGEST_HOST=https://us.i.posthog.com
POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com
